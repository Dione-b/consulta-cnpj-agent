# Copie para .env e preencha. Nunca versione o .env.
OPENAI_API_KEY=
# Qualquer modelo aceito por init_chat_model, no formato provedor:modelo
CHECAGEM_MODELO=openai:gpt-4.1-mini
SEARXNG_URL=http://localhost:8080
# Chave secreta do SearXNG; gere com: openssl rand -hex 32
SEARXNG_SECRET=
# 1 = usar fixtures de tests/fixtures em vez das APIs
CHECAGEM_MOCK=0
# Opcional: traces no Langfuse (pip install -e '.[langfuse]')
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
